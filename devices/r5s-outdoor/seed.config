# Device: NanoPi R5S + outdoor-backup feed (Rockchip armv8)
# 硬件与 r5s 相同; 差异 = outdoor feed(见 pre-feeds.sh)+ 存储包 + 版本标识
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r5s=y
CONFIG_VERSION_CODE="05"
CONFIG_VERSION_HWREV="R5S-OUT"

# PCIe diagnostics (lspci)
# 本设备 M.2 M-key 槽是 PCIe 2.1 Gen2 x1 单 lane, 无法 bifurcation; 槽上同时挂
# NVMe + mt7922 必然经有源 packet switch。诊断 ASPM 链路状态与 switch 拓扑需
# lspci -vv 读 LnkCap/LnkCtl/DevCap, 无替代手段 (自编译内核 hash != 官方, 无法
# opkg 事后装)。仅此设备需要 — 其余设备 M.2 槽为空或无此拓扑。
CONFIG_PACKAGE_pciutils=y

# Storage / Filesystem (outdoor 变体专属)
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_outdoor-backup=y
CONFIG_PACKAGE_luci-app-outdoor-backup=y

# NVMe power-state control (issue #46)
# 本设备 M.2 槽上是 ASM1182e packet switch, 同时喂这块 SSD 和 mt7922, 两端共享
# 一条 Gen2 x1。真机 PCIe ASPM 状态存疑(policy=default 下两条下行链路 l1_aspm 全 0
# 且写不进, PR #42 却记录过 powersave 下为 1), 且 ASPM 动的是链路不是盘。
# `nvme set-feature -f 2` 直接压盘的操作功率档位, 与 ASPM 正交, 故预装 nvme-cli。
CONFIG_PACKAGE_nvme-cli=y

# Wireless (mt7922 via M.2 PCIe)
CONFIG_PACKAGE_kmod-mt7921e=y
CONFIG_PACKAGE_mt7922-firmware=y
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# First-boot auto-expand rootfs (preinit hook: 79_expand_rootfs)
# f2fsck: fsck.f2fs + resize.f2fs; sfdisk: expand p2; losetup: unmounted f2fs view (-o offset)
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_sfdisk=y
CONFIG_PACKAGE_losetup=y
