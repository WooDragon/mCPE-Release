#!/bin/sh /etc/rc.common

# shellcheck disable=SC2034 # rc.common consumes service metadata.
USE_PROCD=1
START=99
STOP=10
WORKER=/usr/libexec/photoprism/worker.sh
CANCEL=/var/run/photoprism.cancel
STOPPING=/var/run/photoprism.stopping
PID=/var/run/photoprism.worker.pid

start_service() {
    [ -e "$STOPPING" ] && return 1
    procd_open_instance
    procd_set_param command "$WORKER" start
    procd_set_param stderr 1
    procd_set_param term_timeout 15
    procd_close_instance
}

wait_old_worker() {
    remaining=15
    while [ "$remaining" -gt 0 ]; do
        [ -r "$PID" ] || return 0
        kill -0 "$(cat "$PID")" 2>/dev/null || return 0
        sleep 1
        remaining=$((remaining - 1))
    done
    return 1
}

stop_service() {
    : > "$CANCEL"
    : > "$STOPPING"
    procd_kill photoprism
    wait_old_worker || { logger -t photoprism 'worker did not terminate before stop timeout'; return 1; }
    "$WORKER" stop || { logger -t photoprism 'project stop failed; retaining retry markers'; return 1; }
    rm -f "$CANCEL" "$STOPPING"
}

status() {
    printf 'enabled=%s\n' "$(uci -q get photoprism.main.enabled)"
    "$WORKER" status
}
