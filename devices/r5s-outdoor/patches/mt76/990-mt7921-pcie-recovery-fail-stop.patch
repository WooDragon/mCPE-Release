+static void mt7921e_rfkill_stop_work(struct work_struct *work)
+{
+	struct mt792x_dev *dev = container_of(work, struct mt792x_dev,
+					      rfkill_work);
+
+	/* REMOVED still owns a live wiphy until removal joins this work. */
+	if (dev->phy.chip_cap & MT792x_CHIP_CAP_WF_RF_PIN_CTRL_EVT_EN)
+		wiphy_rfkill_stop_polling(mt76_hw(dev)->wiphy);
+}
+
+
+static bool mt7921e_publish_failed(struct mt792x_dev *dev)
+{
+	unsigned long flags;
+	bool first = false;
+
+	spin_lock_irqsave(&dev->mt76.mmio.irq_lock, flags);
+	if (!test_bit(MT76_REMOVED, &dev->mphy.state) &&
+	    !test_and_set_bit(MT76_STATE_RECOVERY_FAILED, &dev->mphy.state)) {
+		dev->mt76.mmio.irqmask = 0;
+		mt76_wr(dev, dev->irq_map->host_irq_enable, 0);
+		mt76_wr(dev, MT_PCIE_MAC_INT_ENABLE, 0);
+		first = true;
+	}
+	spin_unlock_irqrestore(&dev->mt76.mmio.irq_lock, flags);
+
+	return first;
+}
+
+static void mt7921e_drain_mcu(struct mt792x_dev *dev)
+{
+	set_bit(MT76_MCU_RESET, &dev->mphy.state);
+	wake_up(&dev->mt76.mcu.wait);
+	wake_up(&dev->pm.wait);
+	wake_up(&dev->phy.roc_wait);
+
+	/* Release waiters before waiting for old callback/request owners. */
+	mutex_lock(&dev->mt76.mutex);
+	mutex_lock(&dev->mt76.mcu.mutex);
+	clear_bit(MT76_STATE_RUNNING, &dev->mphy.state);
+	clear_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state);
+	skb_queue_purge(&dev->mt76.mcu.res_q);
+	mutex_unlock(&dev->mt76.mcu.mutex);
+	mutex_unlock(&dev->mt76.mutex);
+}
+
+static void mt7921e_stop_deferred_work(struct mt792x_dev *dev)
+{
+	cancel_delayed_work(&dev->pm.ps_work);
+	cancel_work(&dev->pm.wake_work);
+	cancel_delayed_work(&dev->coredump.work);
+	cancel_delayed_work_sync(&dev->mphy.mac_work);
+	cancel_delayed_work_sync(&dev->phy.scan_work);
+	del_timer_sync(&dev->phy.roc_timer);
+	cancel_work_sync(&dev->phy.roc_work);
+	if (test_and_clear_bit(MT76_STATE_ROC, &dev->mphy.state))
+		ieee80211_remain_on_channel_expired(mt76_hw(dev));
+	if (IS_ENABLED(CONFIG_IPV6)) {
+		cancel_work_sync(&dev->ipv6_ns_work);
+		skb_queue_purge(&dev->ipv6_ns_list);
+	}
+	skb_queue_purge(&dev->phy.scan_event_list);
+	skb_queue_purge(&dev->coredump.msg_list);
+	mt76_connac_free_pending_tx_skbs(&dev->pm, NULL);
+}
+
+static void mt7921e_reset_failed(struct mt792x_dev *dev)
+{
+	int i;
+
+	if (!mt7921e_publish_failed(dev))
+		return;
+	mt7921e_drain_mcu(dev);
+	synchronize_irq(to_pci_dev(dev->mt76.dev)->irq);
+	tasklet_kill(&dev->mt76.irq_tasklet);
+	mt76_for_each_q_rx(&dev->mt76, i)
+		napi_synchronize(&dev->mt76.napi[i]);
+	napi_synchronize(&dev->mt76.tx_napi);
+	mt7921e_stop_deferred_work(dev);
+	ieee80211_stop_queues(mt76_hw(dev));
+	/* A poll may wait for .stop's wiphy lock; reset must not join it. */
+	if (dev->phy.chip_cap & MT792x_CHIP_CAP_WF_RF_PIN_CTRL_EVT_EN)
+		queue_work(system_unbound_wq, &dev->rfkill_work);
+}
+
 static void mt7921e_unregister_device(struct mt792x_dev *dev)
 {
 	int i;
+	unsigned long flags;
 	struct mt76_connac_pm *pm = &dev->pm;
 	struct ieee80211_hw *hw = mt76_hw(dev);
 
+	spin_lock_irqsave(&dev->mt76.mmio.irq_lock, flags);
